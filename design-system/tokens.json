{
  "$description": "Visual decisions extracted from 2026-07-29_v1.0.0; July dark palette is normative. Light semantic mapping extends the palette for 2026-10-03_v1.0.1.",
  "$extensions": {
    "designSystemVersion": "1.0.0",
    "sourceVersion": "2026-07-29_v1.0.0",
    "extractedAt": "2026-10-03",
    "defaultTheme": "dark",
    "cssSource": "tokens.css",
    "scope": "2026-10-03_v1.0.1 only",
    "initialTheme": "device appearance; explicit preference overrides"
  },
  "color": {
    "$type": "color",
    "navy": {
      "950": {
        "$value": "#04101f",
        "$description": "Page and hero surface."
      },
      "900": {
        "$value": "#081a33",
        "$description": "Navigation and supporting sections."
      },
      "800": {
        "$value": "#0d2748",
        "$description": "Raised or active navigation surface."
      },
      "700": {
        "$value": "#17385f",
        "$description": "Secondary text on light surfaces."
      }
    },
    "ink": {
      "$value": "#05070b",
      "$description": "Foreground on gold actions; footer structure."
    },
    "paper": {
      "$value": "#f5f0e7",
      "$description": "Dark theme foreground and inverse surface."
    },
    "paper-muted": {
      "$value": "#c8c8c4",
      "$description": "Secondary foreground on navy."
    },
    "gold": {
      "$value": "#d9ad59",
      "$description": "Primary action surface and hard offset shadow."
    },
    "gold-soft": {
      "$value": "#f0d48d",
      "$description": "Dark-surface labels, primary hover, focus."
    },
    "pink": {
      "$value": "#ff5c91",
      "$description": "Expressive rules, current-route marker, quote mark."
    },
    "pink-deep": {
      "$value": "#d93f76",
      "$description": "Portrait shadow and stronger pink accent."
    },
    "line": {
      "$value": "rgba(245, 240, 231, 0.18)",
      "$description": "Decorative separators on navy; not a control's sole boundary."
    },
    "light-panel": {
      "$value": "#ebe5d9",
      "$description": "Added neutral for the optional light theme."
    },
    "light-raised": {
      "$value": "#ffffff",
      "$description": "Added neutral for the optional light theme."
    },
    "gold-ink": {
      "$value": "#795219",
      "$description": "Accessible gold-family text on light surfaces."
    },
    "pink-ink": {
      "$value": "#a82556",
      "$description": "Accessible pink-family text on light surfaces."
    }
  },
  "theme": {
    "dark": {
      "$type": "color",
      "surface-page": {
        "$value": "{color.navy.950}"
      },
      "surface-panel": {
        "$value": "{color.navy.900}"
      },
      "surface-raised": {
        "$value": "{color.navy.800}"
      },
      "surface-inverse": {
        "$value": "{color.paper}"
      },
      "surface-scrim": {
        "$value": "rgba(0, 0, 0, 0.6)"
      },
      "text-primary": {
        "$value": "{color.paper}"
      },
      "text-secondary": {
        "$value": "{color.paper-muted}"
      },
      "text-inverse": {
        "$value": "{color.navy.950}"
      },
      "text-on-accent": {
        "$value": "{color.ink}"
      },
      "text-accent": {
        "$value": "{color.gold-soft}"
      },
      "text-expressive": {
        "$value": "{color.pink}"
      },
      "border": {
        "$value": "{color.line}"
      },
      "border-strong": {
        "$value": "rgba(217, 173, 89, 0.42)"
      },
      "accent": {
        "$value": "{color.gold}"
      },
      "accent-hover": {
        "$value": "{color.gold-soft}"
      },
      "expressive": {
        "$value": "{color.pink}"
      },
      "focus": {
        "$value": "{color.gold-soft}"
      }
    },
    "light": {
      "$type": "color",
      "surface-page": {
        "$value": "{color.paper}"
      },
      "surface-panel": {
        "$value": "{color.light-panel}"
      },
      "surface-raised": {
        "$value": "{color.light-raised}"
      },
      "surface-inverse": {
        "$value": "{color.navy.950}"
      },
      "surface-scrim": {
        "$value": "rgba(4, 16, 31, 0.44)"
      },
      "text-primary": {
        "$value": "{color.navy.950}"
      },
      "text-secondary": {
        "$value": "{color.navy.700}"
      },
      "text-inverse": {
        "$value": "{color.paper}"
      },
      "text-on-accent": {
        "$value": "{color.ink}"
      },
      "text-accent": {
        "$value": "{color.gold-ink}"
      },
      "text-expressive": {
        "$value": "{color.pink-ink}"
      },
      "border": {
        "$value": "rgba(4, 16, 31, 0.2)"
      },
      "border-strong": {
        "$value": "rgba(4, 16, 31, 0.46)"
      },
      "accent": {
        "$value": "{color.gold}"
      },
      "accent-hover": {
        "$value": "{color.gold-soft}"
      },
      "expressive": {
        "$value": "{color.pink-deep}"
      },
      "focus": {
        "$value": "{color.navy.700}"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Iowan Old Style",
        "Baskerville",
        "Times New Roman",
        "serif"
      ]
    },
    "sans": {
      "$value": [
        "Avenir Next",
        "Helvetica Neue",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "SFMono-Regular",
        "Cascadia Code",
        "Roboto Mono",
        "monospace"
      ]
    }
  },
  "typography": {
    "display": {
      "fontFamily": "{font.display}",
      "fontSize": "clamp(68px, 7vw, 96px)",
      "fontWeight": 500,
      "lineHeight": 0.9,
      "letterSpacing": "-0.04em"
    },
    "page-title": {
      "fontFamily": "{font.display}",
      "fontSize": "clamp(48px, 5.7vw, 82px)",
      "fontWeight": 500,
      "lineHeight": 0.9,
      "letterSpacing": "-0.04em"
    },
    "section-title": {
      "fontFamily": "{font.display}",
      "fontSize": "clamp(32px, 3.5vw, 48px)",
      "fontWeight": 500,
      "lineHeight": 1.03,
      "letterSpacing": "-0.04em"
    },
    "quote": {
      "fontFamily": "{font.display}",
      "fontSize": "clamp(21px, 1.75vw, 27px)",
      "lineHeight": 1.15,
      "letterSpacing": "-0.025em"
    },
    "body": {
      "fontFamily": "{font.sans}",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "label": {
      "fontFamily": "{font.mono}",
      "fontSize": "11px",
      "fontWeight": 600,
      "letterSpacing": "0.17em"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "28px"
    },
    "8": {
      "$value": "38px"
    },
    "9": {
      "$value": "48px"
    },
    "10": {
      "$value": "72px"
    }
  },
  "layout": {
    "sidebar": "292px",
    "sidebar-collapsed": "92px",
    "mobile-header": "72px",
    "touch-target": "44px",
    "button-height": "52px",
    "page-gutter": "clamp(32px, 6vw, 90px)",
    "section-gutter": "clamp(32px, 6vw, 90px)",
    "section-space": "clamp(86px, 10vw, 148px)",
    "reading-measure": "72ch",
    "breakpoints": {
      "compact": "640px",
      "navigation": "900px",
      "columns": "1180px"
    }
  },
  "shape": {
    "control-radius": "0",
    "round-radius": "50%"
  },
  "motion": {
    "fast": "160ms",
    "turn": "180ms",
    "overlay": "220ms",
    "shell": "260ms",
    "easing": "ease"
  },
  "shadow": {
    "portrait": "18px 18px 0 {color.pink-deep}",
    "testimonial": "14px 14px 0 {color.gold}",
    "navigation": "22px 0 60px rgba(0, 0, 0, 0.4)"
  }
}
